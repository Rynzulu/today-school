	getActiveAcademicYear() {
		const years = this.getAcademicYears();
		const active = years.find((y) => y.is_active);
		if (active) return active;
		const matchSys = years.find((y) => y.year_name === this.state.system_info.academic_year);
		if (matchSys) return matchSys;
		return years[0] || DEFAULT_ACADEMIC_YEARS[0];
	}
	setActiveAcademicYear(yearIdOrName) {
		const years = this.getAcademicYears();
		const target = years.find((y) => y.year_id === yearIdOrName || y.year_name === yearIdOrName);
		if (!target) return false;
		years.forEach((y) => {
			y.is_active = y.year_id === target.year_id;
			if (y.is_active) y.status = "active";
		});
		this.state.system_info.academic_year = target.year_name;
		this.state.system_info.current_term = target.current_term;
		this.persist();
		return true;
	}
